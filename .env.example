# ============================================================================
# AUTOPATCH (SARTHI) — ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env for local development: cp .env.example .env
# Never commit real API keys or secrets to version control.
# ============================================================================

# --- Application & Environment ---
APP_ENV=development
APP_NAME=AutoPatch
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
DEMO_MODE_ENABLED=true
LOG_LEVEL=INFO

# --- Database & Persistence (PostgreSQL / SQLite Fallback) ---
# Use SQLite locally for zero-dependency startup or PostgreSQL in Docker Compose
DATABASE_URL=postgresql+psycopg://autopatch:autopatch_local_dev@localhost:5432/autopatch
SQLITE_FALLBACK_URL=sqlite:///./autopatch_mvp.db

# --- Redis Queue & Worker Coordination ---
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENT_JOBS=4

# --- Qdrant Vector Database (RAG Pipeline) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=autopatch_docs_v1

# --- LLM & Embeddings Provider Configuration ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
EMBEDDING_PROVIDER=local_deterministic
EMBEDDING_MODEL=text-embedding-004
LLM_INPUT_COST_PER_1K_TOKENS=0.00015
LLM_OUTPUT_COST_PER_1K_TOKENS=0.00060

# --- Security, Auth & Encryption ---
JWT_SECRET_KEY=replace-with-32-byte-high-entropy-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
FERNET_MASTER_KEY=replace-with-base64-encoded-32-byte-fernet-key
DEFAULT_WORKSPACE_ID=ws_prod_01

# --- GitHub App / PAT Integration ---
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=acme-org/commerce-core-service
GITHUB_DEFAULT_BASE_BRANCH=main

# --- Isolated Patch Sandbox Limits ---
SANDBOX_MODE=subprocess_isolated
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_QUOTA_PERCENT=50
SANDBOX_MAX_REPAIR_ITERATIONS=3
SANDBOX_NETWORK_DISABLED=true

# --- Proxy Gateway & Monitoring Thresholds ---
UPSTREAM_DEMO_URL=http://localhost:8001
PROXY_CONNECT_TIMEOUT_SECONDS=3.0
PROXY_READ_TIMEOUT_SECONDS=10.0
DEFAULT_LATENCY_THRESHOLD_MS=450
DEFAULT_ERROR_RATE_THRESHOLD_PCT=2.0
